{{> header}}

<main class="mx-auto w-full max-w-2xl px-6 py-10">

  {{> progreso}}

  <div class="mt-8 flex items-center gap-3">
    <div class="flex items-center" style="height:48px;min-width:120px"><svg width="100%" height="28" viewBox="117 8 77 12" fill="none" xmlns="http://www.w3.org/2000/svg">
