<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <title>{{title}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
  html { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

  /* Hover botón continuar */
  #btn-continuar:hover .arrow-circle { border-color: #dc2626; }
  #btn-continuar:hover svg            { stroke: #dc2626; }
  #btn-continuar:hover .continuar-text{ color: #dc2626; }

  /* Celular: inputs más grandes para tocar con dedo */
  @media (max-width: 640px) {
    input, select {
      font-size: 16px !important; /* evita zoom automático en iOS */
      min-height: 44px;
    }
    button[type="submit"] {
      min-height: 48px;
      width: 100%;
      justify-content: center;
    }
    .flex.items-center.justify-between.pt-2,
    .flex.items-center.justify-between.pt-4 {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
</head>
<body class="bg-white text-black antialiased">
  {{{body}}}
</body>
</html>