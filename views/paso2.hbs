  </div>

  <h1 class="mt-6 text-2xl font-extrabold">Detalles del pago</h1>

  {{#if error}}
  <div class="mt-4 rounded border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">
    {{error}}
  </div>
  {{/if}}

  <form action="/paso2" method="POST" class="mt-6 space-y-6" novalidate id="form-paso2">
    <input type="hidden" name="cedula" value="{{cedula}}">

    <div>
      <label for="nombreCliente" class="mb-1 block text-sm font-semibold">
        Nombre completo del cliente <span class="text-red-600">*</span>
      </label>
      <input id="nombreCliente" name="nombreCliente" type="text"
             placeholder="Solo letras y espacios"
             maxlength="80" required value="{{nombreCliente}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="hidden mt-1 text-xs text-red-600" id="err-nombre">Solo se permiten letras, tildes y espacios.</span>
    </div>

    <div>
      <label for="numProducto" class="mb-1 block text-sm font-semibold">
        Número de producto <span class="text-red-600">*</span>
      </label>
      <input id="numProducto" name="numProducto" type="text" inputmode="numeric"
             placeholder="Solo números"
             maxlength="20" required value="{{numProducto}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="hidden mt-1 text-xs text-red-600" id="err-producto">Solo se permiten números.</span>
    </div>

    <div>
      <label for="valorPagar" class="mb-1 block text-sm font-semibold">
        Valor a pagar <span class="text-red-600">*</span>
      </label>
      <input id="valorPagar" name="valorPagar" type="text" inputmode="numeric"
             placeholder="Ej: 150000"
             maxlength="12" required value="{{valorPagar}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="mt-1 text-xs text-gray-400">Solo el valor en números, sin puntos ni comas.</span>
      <span class="hidden mt-1 text-xs text-red-600" id="err-valor">Ingresa un valor numérico válido mayor a 0.</span>
    </div>

    <div>
      <label for="otroValor" class="mb-1 block text-sm font-semibold">
        Valor a pagar con descuento hoy <span class="text-gray-400 font-normal">*</span>
      </label>
      <input id="otroValor" name="otroValor" type="text" inputmode="numeric"
             placeholder="Ej: 20000"
             maxlength="12" value="{{otroValor}}"
             class="w-full border-b border-gray-400 bg-transparent pb-2 text-sm text-gray-600 placeholder-gray-400 outline-none focus:border-black">
      <span class="hidden mt-1 text-xs text-red-600" id="err-otroValor">Si ingresas un valor, debe ser numérico y mayor a 0.</span>
    </div>

    <div class="flex items-start gap-3 pt-2">
      <input id="terminos" name="terminos" type="checkbox" value="aceptado"
             class="mt-0.5 h-4 w-4 flex-shrink-0 cursor-pointer accent-red-600">
      <label for="terminos" class="text-sm text-gray-700 leading-relaxed cursor-pointer">
        Acepto los <a href="#" class="font-semibold text-red-600 underline hover:text-red-700">términos y condiciones</a>
        del servicio de pagos electrónicos PSE y autorizo el tratamiento de mis datos personales conforme a la Ley 1581 de 2012.
      </label>
    </div>
    <span class="hidden mt-1 text-xs text-red-600" id="err-terminos">Debes aceptar los términos y condiciones.</span>

    {{> seguridad}}

    <div class="flex items-center justify-between pt-4">
      <a href="/" aria-label="Volver" class="p-2 text-gray-600 hover:text-black transition-colors duration-150">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
      <button type="submit"
              class="flex items-center gap-3 text-base font-semibold text-gray-700 hover:text-red-600 transition-colors duration-150 group">
        <span>Aceptar y continuar</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 group-hover:border-red-600 transition-colors duration-150">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </button>
    </div>

  </form>
</main>

<script>
  // Nombre: solo letras, tildes y espacios
  const nombre = document.getElementById('nombreCliente');
  nombre.addEventListener('input', () => {
    nombre.value = nombre.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚüÜñÑ\s]/g, '');
  });

  // Número de producto: solo números
  const numProducto = document.getElementById('numProducto');
  numProducto.addEventListener('input', () => {
    numProducto.value = numProducto.value.replace(/[^0-9]/g, '');
  });

  // Valor a pagar: solo números
  const valorPagar = document.getElementById('valorPagar');
  valorPagar.addEventListener('input', () => {
    valorPagar.value = valorPagar.value.replace(/[^0-9]/g, '');
  });

  // Otro valor: solo números
  const otroValor = document.getElementById('otroValor');
  otroValor.addEventListener('input', () => {
    otroValor.value = otroValor.value.replace(/[^0-9]/g, '');
  });

  // Validación al enviar
  document.getElementById('form-paso2').addEventListener('submit', function(e) {
    let ok = true;

    const errNombre = document.getElementById('err-nombre');
    if (!/^[a-zA-ZáéíóúÁÉÍÓÚüÜñÑ\s]{2,80}$/.test(nombre.value.trim())) {
      errNombre.classList.remove('hidden'); ok = false;
    } else { errNombre.classList.add('hidden'); }

    const errProducto = document.getElementById('err-producto');
    if (!/^[0-9]{1,20}$/.test(numProducto.value)) {
      errProducto.classList.remove('hidden'); ok = false;
    } else { errProducto.classList.add('hidden'); }

    const errValor = document.getElementById('err-valor');
    if (!/^[0-9]+$/.test(valorPagar.value) || parseInt(valorPagar.value) <= 0) {
      errValor.classList.remove('hidden'); ok = false;
    } else { errValor.classList.add('hidden'); }

    const errOtro = document.getElementById('err-otroValor');
    if (otroValor.value && (!/^[0-9]+$/.test(otroValor.value) || parseInt(otroValor.value) <= 0)) {
      errOtro.classList.remove('hidden'); ok = false;
    } else { errOtro.classList.add('hidden'); }

    const terminos = document.getElementById('terminos');
    const errTerminos = document.getElementById('err-terminos');
    if (!terminos.checked) {
      errTerminos.classList.remove('hidden'); ok = false;
    } else { errTerminos.classList.add('hidden'); }

    if (!ok) e.preventDefault();
  });
</script>